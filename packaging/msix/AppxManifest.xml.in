<?xml version="1.0" encoding="utf-8"?>
<!--
  NeNe Ledger の MSIX の宣言（ADR 0035・GitHub Issue #342）。tools/msix.sh が @…@ を埋めて AppxManifest.xml にする。
  - Identity の Name と Publisher、PublisherDisplayName は Partner Center で名前を予約したときの値（施主が入れる・
    packaging/msix/identity.env）。ストアの側で署名するので、手元の包みは署名しない。
  - 版は 4 桁で、ストアの決まりで 4 桁目は 0（tools/msix.sh が Cargo.toml の版から導く）。
  - Win32 の exe をそのまま包む（runFullTrust・desktop bridge）。設定は %APPDATA% に書き、MSIX が包みごとに分ける。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NeNe Ledger</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Fast CSV/TSV editor that never changes your values.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 以降（自前のタイトルバーと DirectWrite が動く範囲）。 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="NeNeLedger" Executable="nene-ledger.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NeNe Ledger"
        Description="Fast CSV/TSV editor that never changes your values."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- CSV と TSV を「プログラムから開く」に出す（既定のアプリは利用者が選ぶ）。開くファイルは引数で渡る。 -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="delimitedtext">
            <uap:DisplayName>CSV / TSV</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="text/csv">.csv</uap:FileType>
              <uap:FileType ContentType="text/tab-separated-values">.tsv</uap:FileType>
              <uap:FileType>.tab</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
